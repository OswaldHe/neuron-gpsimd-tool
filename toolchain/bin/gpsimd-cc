#!/usr/bin/env python3
"""gpsimd-cc - build a trn3 GPSIMD operator library for the call sites of an NKI kernel.

  gpsimd-cc --sites <sites_resolved.json> -o <ops.so> <op.cpp|op.c> [...] [-DNAME=V] [-I dir] [-O2|-O3|-Os]
            [--log-size BYTES] [--keep] [--allow-vector]

Generates the call-site table (tile descriptors resolved by `gpsimd-neff analyze`) and one entry stub
"<kernel>__s<site>" per call site, compiles the operator sources and the runtime (dispatch, receipts,
log ring, barrier/reductions, soft-float, compiler helpers) with xt-clang for base-ISA Xtensa, links a
position-independent kernel library (pisplitload layout, GNU build-id, "Neuron" kernel notes) and
checks it: only base-ISA instructions (no FLIX/FPU/vector bundles), no unresolved symbols, no static
constructors, fits the per-library budgets (64 KB code, 8 KB data). --allow-vector skips the FLIX check, for
operators that embed raw trn3 vector bundles (include/gpsimd/vec.h); the compiler itself still emits base ISA only.

Environment: GPSIMD_TOOLS (default /opt/aws/neuron/gpsimd).
"""
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
RUNTIME = [os.path.join(ROOT, "runtime", f) for f in ("rt.c", "builtins.c", "softfloat.c")]
IRAM_BUDGET, DRAM_BUDGET = 64 * 1024, 7 * 1024
# -mno-serialize-volatile: no memw before every volatile access (stores to SBUF/HBM become posted, 19 instead
# of ~300 cycles); the runtime issues memw where ordering matters (barrier, lock, iDMA, end of call).
BASE_FLAGS = ["-fpic", "-mno-flix", "-mno-generate-flix", "-mno-coproc", "-mno-serialize-volatile", "-ffreestanding",
              "-mno-target-align",     # no alignment padding: the compiler pads with ncore2gp FLIX nops, which trn3 decodes differently
              "-fno-builtin", "-fno-jump-tables", "-Wall", "-Werror", "-Wno-unused-function"]
CXX_FLAGS = ["-std=c++17", "-fno-exceptions", "-fno-rtti", "-fno-threadsafe-statics", "-fno-use-cxa-atexit"]


def die(msg):
    sys.stderr.write(f"gpsimd-cc: error: {msg}\n")
    sys.exit(1)


def tool_env():
    tools = os.environ.get("GPSIMD_TOOLS", "/opt/aws/neuron/gpsimd")
    env = dict(os.environ)
    env.setdefault("XTENSA_SYSTEM", f"{tools}/tools/ncore2gp/config")
    env.setdefault("XTENSA_CORE", "ncore2gp")
    env.setdefault("LM_LICENSE_FILE", f"{tools}/tools/licenses/amzn_vq7_us_582883.out")
    env["PATH"] = f"{tools}/bin:" + env.get("PATH", "")
    if not os.path.exists(f"{tools}/bin/xt-clang"):
        die(f"xt-clang not found in {tools}/bin (install aws-neuronx-gpsimd-tools or set GPSIMD_TOOLS)")
    return env


def run(cmd, env, quiet_unused=True):
    p = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    err = "\n".join(l for l in p.stderr.splitlines() if not (quiet_unused and "argument unused during compilation" in l))
    if p.returncode:
        sys.stderr.write(err + "\n")
        die(f"command failed: {' '.join(cmd)}")
    if err.strip():
        sys.stderr.write(err + "\n")
    return p.stdout


def c_ident(s):
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", s):
        die(f"operator name {s!r} is not a C identifier")
    return s


def gen_sites(resolved, path):
    sites = resolved["sites"]
    lines = ["/* generated by gpsimd-cc from the call sites of the NKI kernel */",
             "#include <gpsimd/gpsimd.h>", "#include <gpsimd/neuron_kl.h>", "",
             "void gp_dispatch(const gp_site *site, gp_op_fn fn, uint32_t *exec_counter, uint32_t entry_pc);", "",
             "const gp_tile gp_tiles[] = {"]
    first, rows = 0, []
    for st in sites:
        st["_first"] = first
        for kind, tiles in (("in", st["ins"]), ("out", st["outs"]), ("scratch", [st["scratch"]])):
            for k, t in enumerate(tiles):
                dims = t["dims"]
                if len(dims) > 3:
                    die(f"site {st['site']} {kind} {k}: more than 3 free dimensions")
                steps = [d[0] for d in dims] + [0] * (3 - len(dims))
                nums = [d[1] for d in dims] + [1] * (3 - len(dims))
                contiguous = int(len(dims) == 1 and dims[0][0] == 1)
                rows.append(f"    {{{t['part0']}u, {t['nparts']}u, 0x{t['offset']:05x}u, {t['elems']}u, 0x{t['dtype_code']:02x}, "
                            f"{t['elem_bytes']}, {len(dims)}, {contiguous}, {{{', '.join(map(str, steps))}}}, "
                            f"{{{', '.join(map(str, nums))}}}}},   /* site {st['site']} {kind} {k}: {t['dtype']} */")
                first += 1
    lines += rows + ["};", "", "static const gp_site sites[] = {"]
    for st in sites:
        lines.append(f"    {{{st['site']}, {len(st['ins'])}, {len(st['outs'])}, {st['_first']}}},   /* {st['entry']} */")
    lines += ["};", f"static uint32_t exec_count[{len(sites)}];", ""]
    for kernel in sorted({st["kernel"] for st in sites}):
        lines.append(f"void {c_ident(kernel)}(gp_call *call);")
    lines.append("")
    for n, st in enumerate(sites):
        e = st["entry"]
        lines += [f"void {e}(void) {{ gp_dispatch(&sites[{n}], {st['kernel']}, &exec_count[{n}], (uint32_t)&{e}); }}",
                  f"NEURON_KERNEL({e});"]
    open(path, "w").write("\n".join(lines) + "\n")


def elf_check(so, env, allow_vector=False):
    elf = open(so, "rb").read()
    shoff, = struct.unpack_from("<I", elf, 0x20)
    shentsize, shnum, shstrndx = struct.unpack_from("<HHH", elf, 0x2e)
    secs = []
    for i in range(shnum):
        name, typ, flags, addr, off, size = struct.unpack_from("<IIIIII", elf, shoff + i * shentsize)
        secs.append([name, typ, flags, addr, off, size])
    stro = secs[shstrndx][4]
    for s in secs:
        s[0] = elf[stro + s[0]:elf.index(b"\0", stro + s[0])].decode()
    names = {s[0] for s in secs}
    for bad in (".init_array", ".ctors", ".fini_array"):
        if bad in names:
            die(f"{so}: has {bad} (static constructors/destructors are not run on the GPSIMD; use constexpr/POD globals)")
    text = sum(s[5] for s in secs if s[2] & 0x4 and s[2] & 0x2)                  # SHF_EXECINSTR & SHF_ALLOC
    data = sum(s[5] for s in secs if s[2] & 0x2 and not s[2] & 0x4 and s[3] >= 0x02000000 and s[3] < 0x03000000)
    if text > IRAM_BUDGET:
        die(f"{so}: code {text} bytes exceeds the {IRAM_BUDGET}-byte instruction RAM budget")
    if data > DRAM_BUDGET:
        die(f"{so}: data+bss {data} bytes exceeds the {DRAM_BUDGET}-byte data RAM budget (reduce --log-size / tables)")
    und = [l.split()[-1] for l in run(["xt-nm", "-u", so], env).splitlines() if l.strip()]
    if und:
        die(f"{so}: unresolved symbols {und} (no libc/libgcc/heap on the GPSIMD; implement them or avoid the construct)")
    dis = run(["xt-objdump", "-d", so], env)
    flix = [l for l in dis.splitlines() if re.match(r"^\s+[0-9a-f]+:\s+[0-9a-f]{16,}\s", l)]
    pad = [l for l in flix if re.search(r"\{\s*nop(;\s*nop)*\s*\}", l)]
    if pad:
        die(f"{so}: the compiler inserted {len(pad)} FLIX nop bundle(s) (trn1 encoding; trn3 decodes them differently):\n  "
            f"{pad[0].strip()}")
    if flix and not allow_vector:
        fp = [l for l in flix if re.search(r"\.s\b|\.d\b|float|trunc|ufloat|madd|msub", l)]
        hint = ("native float/double arithmetic (use gp::f32 / sf_* soft-float)" if fp else
                "FLIX/vector bundles (intrinsics or auto-generated wide instructions)")
        die(f"{so}: contains {len(flix)} FLIX bundle(s): {hint}; the trn3 GPSIMD core executes base-ISA "
            f"Xtensa only.\n  first: {flix[0].strip()}")
    return text, data


def main():
    a = sys.argv[1:]
    sites_json, out, srcs, cflags, opt, log_size, keep, allow_vector = None, None, [], [], "-O2", 1024, False, False
    i = 0
    while i < len(a):
        x = a[i]
        if x == "--sites":
            sites_json = a[i + 1]; i += 2; continue
        if x == "-o":
            out = a[i + 1]; i += 2; continue
        if x == "--log-size":
            log_size = int(a[i + 1]); i += 2; continue
        if x == "--keep":
            keep = True; i += 1; continue
        if x == "--allow-vector":
            allow_vector = True; i += 1; continue
        if x in ("-O0", "-O1", "-O2", "-O3", "-Os"):
            opt = x; i += 1; continue
        if x == "-I":
            cflags += ["-I", os.path.abspath(a[i + 1])]; i += 2; continue
        if x.startswith(("-D", "-I", "-U", "-W", "-f")):
            cflags.append(x); i += 1; continue
        if x.startswith("-"):
            die(f"unknown option {x}\n{__doc__}")
        srcs.append(os.path.abspath(x)); i += 1
    if not (sites_json and out and srcs):
        sys.stderr.write(__doc__)
        sys.exit(2)
    env = tool_env()
    resolved = json.load(open(sites_json))
    out = os.path.abspath(out)
    work = out[:-3] + ".build" if out.endswith(".so") else out + ".build"
    shutil.rmtree(work, ignore_errors=True)
    os.makedirs(work)
    inc = ["-I", os.path.join(ROOT, "include")]
    gen = os.path.join(work, "gp_sites.c")
    gen_sites(resolved, gen)
    objs = []
    for src in [gen] + RUNTIME + srcs:
        obj = os.path.join(work, f"{len(objs):02d}_" + os.path.basename(src) + ".o")
        is_cxx = src.endswith((".cpp", ".cc", ".cxx"))
        cc = ["xt-clang++"] + CXX_FLAGS if is_cxx else ["xt-clang", "-std=gnu11"]
        extra = [f"-DGP_LOG_SIZE={log_size}"] if src.endswith("rt.c") else []
        run(cc + [opt] + BASE_FLAGS + inc + cflags + extra + ["-c", src, "-o", obj], env)
        objs.append(obj)
    run(["xt-clang", "-nostdlib", "-nostartfiles", f"-mlsp={os.path.join(ROOT, 'lsp')}", "-Wl,--shared-pagesize=128",
         "-Wl,-pie", "-Wl,--build-id", "-Wl,-e,_start", "-o", out] + objs, env)
    nm = os.path.join(work, "ops.nm")
    open(nm, "w").write(run(["xt-nm", out], env))
    notes = run([sys.executable, "-I", os.path.join(HERE, "klpatch.py"), out, nm], env)
    text, data = elf_check(out, env, allow_vector)
    n_entry = notes.count("entry =")
    if n_entry != len(resolved["sites"]):
        die(f"expected {len(resolved['sites'])} kernel notes, patched {n_entry}")
    if not keep:
        shutil.rmtree(work, ignore_errors=True)
    print(f"gpsimd-cc: {out}: {len(resolved['sites'])} call site(s) "
          f"[{', '.join(st['entry'] for st in resolved['sites'])}], code {text} B, data {data} B")


if __name__ == "__main__":
    main()
